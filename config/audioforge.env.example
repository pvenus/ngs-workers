# Shell template, not a running service configuration. No secrets or model files.
# Set these two absolute directories yourself before sourcing a PRIVATE copy.
# WORKERS_DATA_ROOT: dedicated writable audio data directory outside the Git tree.
# ACE_RUNTIME_ROOT: existing approved ACE installation, not the service venv.
export AUDIOFORGE_DATA_DIR="${WORKERS_DATA_ROOT:?Set your absolute audio data directory}"
export AUDIOFORGE_ACESTEP_ROOT="${ACE_RUNTIME_ROOT:?Set your existing approved ACE runtime directory}"
export AUDIOFORGE_DB_PATH="$AUDIOFORGE_DATA_DIR/queue.sqlite3"
export AUDIOFORGE_ARTIFACT_DIR="$AUDIOFORGE_DATA_DIR/artifacts"
export AUDIOFORGE_API_URL="http://127.0.0.1:8765"
export AUDIOFORGE_GATEWAY_URL="http://127.0.0.1:8767"
# Explicit real backend; never fall back to mock for operational requests.
export AUDIOFORGE_BACKEND="ace-step"
export AUDIOFORGE_MODEL="acestep-v15-turbo"
# No license acceptance is performed by these assignments. Preserve validated
# model metadata/provenance; do not fabricate a MODEL_LICENSE or MODEL_VERSION.
# Legacy Stable Audio requests additionally require their independently approved
# runtime and weights. Configure AUDIOFORGE_STABLE_AUDIO_MLX_DIR separately only
# if that existing route is actually used; this template does not provision it.
